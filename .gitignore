# Runtime state and storage
.storage/
.cloud/
.claude/
.uuid
.ha_run.lock

# Logs
home-assistant.log*
*.log
*.log.*

# Databases
home-assistant_v2.db*
*.db
*.db-shm
*.db-wal

# Secrets — never commit
secrets.yaml
known_devices.yaml

# Auth and tokens
.HA_VERSION

# Backups
backups/
*.tar
*.tar.gz

# OS junk
.DS_Store
Thumbs.db

# Editor scratch
*.swp
*.swo
*~
.vscode/
.idea/

# Add-on data (most of it is regenerable; keep config but exclude state)
addons/
addon_configs/

# HACS — install location, regenerable
custom_components/
www/community/

# Zigbee runtime state — keep config, exclude DBs
zigbee.db*
zigbee2mqtt/state.json
zigbee2mqtt/database.db
zigbee2mqtt/log/

# Image and brand cache (regenerated by HA on startup)
.cache/
image/
tts/

# Tuya/cloud integration tokens
tuya/
